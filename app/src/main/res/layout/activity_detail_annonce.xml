<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gris_fond"
    tools:context=".DetailAnnonce">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/img_detail_annonce"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:contentDescription="@string/cd_photo_annonce"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/champ_titre"
                android:textColor="@color/texte_secondaire" />
            <TextView
                android:id="@+id/txt_detail_titre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ardoise_fonce"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/champ_prix"
                android:textColor="@color/texte_secondaire" />
            <TextView
                android:id="@+id/txt_detail_prix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/vert_fonce"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/champ_quartier"
                android:textColor="@color/texte_secondaire" />
            <TextView
                android:id="@+id/txt_detail_quartier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ardoise_fonce" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/champ_description"
                android:textColor="@color/texte_secondaire" />
            <TextView
                android:id="@+id/txt_detail_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ardoise_fonce" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/champ_vendeur"
                android:textColor="@color/texte_secondaire" />
            <TextView
                android:id="@+id/txt_detail_vendeur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ardoise_fonce" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_appel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/vert"
            android:text="@string/btn_appel"
            android:textColor="@color/white" />

    </LinearLayout>
</ScrollView>