<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@color/gris_surface"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:id="@+id/img_annonce"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:contentDescription="@string/cd_photo_annonce"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp">

        <TextView
            android:id="@+id/txt_titre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ardoise_fonce"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_prix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/vert_fonce"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_quartier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/texte_secondaire" />

        <TextView
            android:id="@+id/txt_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/texte_desactive"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_details"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:backgroundTint="@color/bleu_acier"
        android:text="@string/btn_details"
        android:textColor="@color/white" />

</LinearLayout>